---
import Icon from './Icon.astro';
import { getCopy, getLang } from '../data/i18n';
import { projectLabels, projects, projectsPath } from '../data/projects';

const t = getCopy(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const featured = projects.filter((p) => p.home);
---
<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head-row">
      <header class="section-head reveal">
        <span class="eyebrow">{t.work.eyebrow}</span>
        <h2 id="work-title">{t.work.title}<em>{t.work.titleEm}</em></h2>
      </header>
      <a class="btn btn-secondary reveal" href={projectsPath[lang]}>{t.work.all} <Icon name="arrow-right" /></a>
    </div>

    <ul class="grid">
      {featured.map((p, i) => (
        <li class="reveal" style={`--delay:${i * 0.08}s`}>
          <a class="card project" href={`${projectsPath[lang]}${p.slug}/`}>
            <span class="tag">{projectLabels[lang].categories[p.category]}</span>
            <h3>{p.name}</h3>
            <p class="summary">{p.copy[lang].summary}</p>
            <span class="more">{t.work.readMore} <Icon name="arrow-right" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .head-row .section-head { margin-bottom: 0; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .grid li { display: flex; }
  .project {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 14px;
    width: 100%;
    padding: clamp(24px, 3vw, 32px);
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .project:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: color-mix(in srgb, var(--emphasis) 35%, var(--border));
  }
  .tag { color: var(--text-muted); font: 400 12px/1.4 var(--font-mono); }
  h3 { font-size: 28px; line-height: 1.2; }
  .summary { color: var(--text-muted); }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--emphasis);
    font-weight: 600;
    font-size: 15px;
  }
  .more :global(svg) { transition: transform 0.2s ease; }
  .project:hover .more :global(svg) { transform: translateX(3px); }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .head-row { flex-direction: column; align-items: flex-start; }
  }
</style>
