---
// The reading page, rendered once per language by src/pages/{reading,es/lecturas,nl/leeslijst}.astro.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLang, getCopy, homePath } from '../data/i18n';
import { reading, readingPath, readingDates } from '../data/reading';

const lang = getLang(Astro.currentLocale);
const t = getCopy(lang);
const r = reading[lang];
const url = new URL(readingPath[lang], Astro.site).href;
const homeUrl = new URL(homePath(lang), Astro.site).href;
const fmt = new Intl.DateTimeFormat(t.writing.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });

const person = { '@id': `${site.url}/#person` };
const book = (name: string, author: string, extra = {}) => ({
  '@type': 'Book',
  name,
  author: { '@type': 'Person', name: author },
  ...extra,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.brand },
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: r.title,
      description: r.meta.description,
      inLanguage: lang,
      isPartOf: { '@id': `${site.url}/#website` },
      author: { '@type': 'Person', ...person, name: site.name, url: site.url },
      datePublished: readingDates.published,
      dateModified: readingDates.modified,
      breadcrumb: { '@id': `${url}#breadcrumb` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [
          ...r.books.map((b) => book(b.title, b.author, b.year ? { datePublished: String(b.year) } : {})),
          book(r.now.title, r.now.author, { publisher: { '@type': 'Organization', name: "O'Reilly Media" } }),
          book(r.own.title, site.name, { inLanguage: 'es', url: r.own.href }),
        ].map((item, i) => ({ '@type': 'ListItem', position: i + 1, item })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.brand, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: r.breadcrumb, item: url },
      ],
    },
  ],
};
---
<Base title={r.meta.title} description={r.meta.description} alternates={readingPath} jsonLd={jsonLd}>
  <Header alternates={readingPath} />
  <main id="main" class="reading">
    <div class="container narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath(lang)}>{site.brand}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{r.breadcrumb}</span>
      </nav>

      <header class="intro">
        <h1>{r.title}</h1>
        <p class="lead">{r.intro}</p>
        <p class="byline">
          {r.labels.author} <a href={homePath(lang)}>{site.name}</a>{' · '}
          {r.labels.published} <time datetime={readingDates.published}>{fmt.format(new Date(readingDates.published))}</time>
          {readingDates.modified !== readingDates.published && (
            <>{' · '}{r.labels.updated} <time datetime={readingDates.modified}>{fmt.format(new Date(readingDates.modified))}</time></>
          )}
        </p>
      </header>

      <ol class="books">
        {r.books.map((b) => (
          <li class="card book" id={b.id}>
            <h2>
              <cite>{b.title}</cite>
              <span class="by">{b.author}{b.year && ` (${b.year})`}</span>
            </h2>
            {b.note && <p class="note">{b.note}</p>}
            <h3 class="label">{r.labels.learned}</h3>
            <p>{b.learned}</p>
            <h3 class="label">{r.labels.today}</h3>
            <p>{b.today}</p>
            <a class="more" href={b.review.href} hreflang={b.review.lang}>
              {b.review.label} <Icon name="arrow-up-right" />
            </a>
          </li>
        ))}
      </ol>

      <section class="extra" aria-labelledby="now-title">
        <h2 class="eyebrow" id="now-title">{r.labels.now}</h2>
        <div class="card book">
          <h3 class="title">
            <cite>{r.now.title}</cite>
            <span class="by">{r.now.author} ({r.now.publisher})</span>
          </h3>
          <p>{r.now.text}</p>
        </div>
      </section>

      <section class="extra" aria-labelledby="own-title">
        <h2 class="eyebrow" id="own-title">{r.labels.own}</h2>
        <div class="card book own">
          <h3 class="title"><cite lang="es">{r.own.title}</cite></h3>
          <p>{r.own.text}</p>
          <a class="more" href={r.own.href} rel="noopener">{r.labels.buy} <Icon name="arrow-up-right" /></a>
        </div>
      </section>

      <aside class="author" aria-label={r.labels.author}>
        <p class="name">{site.name}</p>
        <p>{r.authorBio}</p>
        <p class="links">
          <a href={site.linkedin} rel="me noopener">LinkedIn <Icon name="arrow-up-right" /></a>
          <a href={site.github} rel="me noopener">GitHub <Icon name="arrow-up-right" /></a>
        </p>
      </aside>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .reading { padding-block: clamp(40px, 6vw, 72px) clamp(72px, 10vw, 128px); }
  .narrow { max-width: 46rem; }

  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 44px);
    color: var(--text-muted);
    font: 400 13px/1.4 var(--font-mono);
  }
  .crumbs a { color: inherit; }

  .intro { display: grid; gap: 20px; margin-bottom: clamp(40px, 6vw, 64px); }
  h1 { font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); line-height: 1.05; }
  .byline { color: var(--text-muted); font-size: 14px; }
  .byline a { color: var(--emphasis); }

  .books { display: grid; gap: 20px; }
  .book { display: grid; gap: 10px; padding: clamp(22px, 3vw, 32px); }
  .book h2,
  .book .title {
    display: grid;
    gap: 6px;
    margin-bottom: 8px;
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.75rem);
    line-height: 1.2;
  }
  cite { font-style: italic; }
  .by { color: var(--text-muted); font: 400 14px/1.4 var(--font-sans); }
  .note { color: var(--text-muted); font-size: 14px; }
  .label {
    margin-top: 8px;
    color: var(--emphasis);
    font: 600 12px/1.4 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    margin-top: 8px;
    color: var(--emphasis);
    font-weight: 600;
    font-size: 15px;
  }
  .more :global(svg) { width: 16px; height: 16px; flex: none; }

  .extra { display: grid; gap: 16px; justify-items: start; margin-top: clamp(40px, 6vw, 56px); }
  .extra .card { width: 100%; }
  .extra .eyebrow { font-size: 12px; }

  .author {
    display: grid;
    gap: 6px;
    margin-top: clamp(48px, 7vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }
  .author .name { color: var(--heading); font: 500 20px/1.3 var(--font-display); }
  .links { display: flex; gap: 20px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; color: var(--emphasis); font-weight: 600; }
  .links :global(svg) { width: 14px; height: 14px; }
</style>
