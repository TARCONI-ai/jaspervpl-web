---
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'moon' | 'sun' | 'menu' | 'close' | 'wave' | 'check' | 'trend' | 'shield' | 'plus' | 'star' | 'copy';
  class?: string;
}
const { name, class: className } = Astro.props;
---
{name === 'star' ? (
  <svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M12 0c.6 6.5 5.5 11.4 12 12-6.5.6-11.4 5.5-12 12-.6-6.5-5.5-11.4-12-12C6.5 11.4 11.4 6.5 12 0Z" />
  </svg>
) : (
  <svg class:list={['icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
    {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
    {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
    {name === 'moon' && <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" />}
    {name === 'sun' && <g><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></g>}
    {name === 'menu' && <path d="M4 8h16M4 16h16" />}
    {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
    {name === 'wave' && <path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2" />}
    {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
    {name === 'trend' && <g><path d="M4 17.5 9.5 12l3.5 2.5L20 7" /><path d="M15 7h5v5" /></g>}
    {name === 'shield' && <path d="M5 4h14v7.5c0 4.2-3 7-7 8.5-4-1.5-7-4.3-7-8.5V4Z" />}
    {name === 'plus' && <path d="M12 6v12M6 12h12" />}
    {name === 'copy' && <g><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M5 15V6a1 1 0 0 1 1-1h9" /></g>}
  </svg>
)}

<style>
  .icon { width: 1em; height: 1em; flex: none; }
</style>
