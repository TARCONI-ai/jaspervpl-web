---
import { getCopy } from '../data/i18n';

const t = getCopy(Astro.currentLocale);
---
<section class="section method" id="method" aria-labelledby="method-title">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">{t.method.eyebrow}</span>
      <h2 id="method-title">{t.method.title}<em>{t.method.titleEm}</em></h2>
      <p>{t.method.intro}</p>
    </header>

    <ol class="steps">
      {t.method.steps.map((step, i) => (
        <li class="card step reveal" style={`--delay:${i * 0.08}s`}>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          <p class="output"><span class="sr-only">{t.a11y.deliverable}</span>{step.output}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 12px;
    padding: 28px 26px 24px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .step:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--emphasis) 35%, var(--border));
    box-shadow: var(--shadow-soft);
  }
  /* Large numbers in Text Gold: 4.67:1 on the light-vanilla card */
  .num {
    font: 500 48px/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--label);
    margin-bottom: 8px;
  }
  h3 { font-size: 24px; line-height: 1.2; }
  .step p { color: var(--text-muted); }
  .output {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
    font: 400 13px/1.4 var(--font-mono);
    color: var(--text) !important;
  }
  .output::before {
    content: "";
    flex: none;
    width: 18px;
    height: 1px;
    background: var(--decor);
  }
  @media (max-width: 1080px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .steps { grid-template-columns: 1fr; } }
</style>
