---
// Resources index (no slug) or one resource (slug). Rendered by src/pages/{resources,es/recursos,nl/resources}/.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLang, homePath, type Lang } from '../data/i18n';
import { resources, resourcesPath } from '../data/resources';
import { reading } from '../data/reading';

interface Props {
  slug?: string;
}

const lang = getLang(Astro.currentLocale);
const c = resources[lang];
const r = Astro.props.slug ? c.items.find((i) => i.slug === Astro.props.slug) : undefined;
const pathOf = (l: Lang) => (r ? `${resourcesPath[l]}${r.slug}/` : resourcesPath[l]);
const alternates = { en: pathOf('en'), es: pathOf('es'), nl: pathOf('nl') };
const url = new URL(pathOf(lang), Astro.site).href;
const fmt = new Intl.DateTimeFormat(c.labels.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });

const crumbs = [
  { name: site.brand, item: new URL(homePath(lang), Astro.site).href },
  { name: c.title, item: new URL(resourcesPath[lang], Astro.site).href },
  ...(r ? [{ name: r.name, item: url }] : []),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.brand },
    {
      '@type': r ? 'WebPage' : 'CollectionPage',
      '@id': url,
      url,
      name: r ? r.title : c.title,
      description: r ? r.summary : c.meta.description,
      inLanguage: lang,
      isPartOf: { '@id': `${site.url}/#website` },
      breadcrumb: { '@id': `${url}#breadcrumb` },
      ...(r ? { mainEntity: { '@id': `${url}#software` } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: crumbs.map((x, i) => ({ '@type': 'ListItem', position: i + 1, ...x })),
    },
    ...(r
      ? [
          {
            '@type': 'SoftwareSourceCode',
            '@id': `${url}#software`,
            name: r.name,
            description: r.summary,
            codeRepository: r.download.source,
            license: 'https://opensource.org/licenses/MIT',
            author: { '@id': `${site.url}/#person` },
            datePublished: r.published,
            dateModified: r.modified,
          },
        ]
      : []),
  ],
};
---
<Base
  title={r ? `${r.name} · ${site.name}` : c.meta.title}
  description={r ? r.summary : c.meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Header alternates={alternates} />
  <main id="main" class="resources">
    <div class="container narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath(lang)}>{site.brand}</a>
        <span aria-hidden="true">/</span>
        {r ? <a href={resourcesPath[lang]}>{c.title}</a> : <span aria-current="page">{c.title}</span>}
      </nav>

      {!r && (
        <>
          <header class="head">
            <h1>{c.title}</h1>
            <p class="lead">{c.intro}</p>
          </header>
          <ul class="cards">
            {c.items.map((i) => (
              <li>
                <a class="card item" href={`${resourcesPath[lang]}${i.slug}/`}>
                  <span class="tag">{i.name}</span>
                  <h2>{i.title}</h2>
                  <p>{i.summary}</p>
                  <span class="more">{c.labels.open} <Icon name="arrow-right" /></span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      {r && (
        <article>
          <header class="head">
            <span class="tag">{r.name}</span>
            <h1>{r.title}</h1>
            <p class="lead">{r.answer}</p>
            <p>{r.forWhom}</p>
            <p class="byline">
              {c.labels.author} <a href={homePath(lang)}>{site.name}</a>{' · '}
              {c.labels.published} <time datetime={r.published}>{fmt.format(new Date(r.published))}</time>
              {r.modified !== r.published && <>{' · '}{c.labels.updated} <time datetime={r.modified}>{fmt.format(new Date(r.modified))}</time></>}
            </p>
            <div class="actions">
              <a class="btn btn-primary" href={r.download.zip} download>{c.labels.download} <Icon name="arrow-down" /></a>
              <a class="btn btn-secondary" href={r.download.source} rel="noopener">{c.labels.github} <Icon name="arrow-up-right" /></a>
            </div>
          </header>

          {r.sections.map((s) => (
            <section class="block">
              <h2>{s.title}</h2>
              {s.text && <p>{s.text}</p>}
              {s.items && (
                <ul class="steps">
                  {s.items.map((x) => <li><strong>{x.label}:</strong> {x.text}</li>)}
                </ul>
              )}
            </section>
          ))}

          <p class="license">{c.labels.license}</p>

          <aside class="author" aria-label={c.labels.author}>
            <p class="name">{site.name}</p>
            <p>{reading[lang].authorBio}</p>
            <p class="links">
              <a href={site.linkedin} rel="me noopener">LinkedIn <Icon name="arrow-up-right" /></a>
              <a href={site.github} rel="me noopener">GitHub <Icon name="arrow-up-right" /></a>
            </p>
          </aside>
        </article>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .resources { padding-block: clamp(40px, 6vw, 72px) clamp(72px, 10vw, 128px); }
  .narrow { max-width: 46rem; }

  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 44px);
    color: var(--text-muted);
    font: 400 13px/1.4 var(--font-mono);
  }
  .crumbs a { color: inherit; }

  .head { display: grid; gap: 18px; justify-items: start; margin-bottom: clamp(36px, 5vw, 56px); }
  h1 { font-size: clamp(2rem, 1.6rem + 2vw, 3rem); line-height: 1.1; }
  .byline { color: var(--text-muted); font-size: 14px; }
  .tag { color: var(--text-muted); font: 400 13px/1.4 var(--font-mono); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .cards { display: grid; gap: 20px; }
  .item { display: grid; gap: 12px; padding: clamp(22px, 3vw, 32px); color: inherit; text-decoration: none; }
  .item h2 { font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem); line-height: 1.2; }
  .item p { color: var(--text-muted); }
  .more { display: inline-flex; align-items: center; gap: 8px; color: var(--emphasis); font-weight: 600; }
  .more :global(svg) { width: 16px; height: 16px; }

  .block + .block { margin-top: 36px; }
  .block h2 { margin-bottom: 12px; font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.6rem); }
  .block p { font-size: 18px; line-height: 1.7; }
  .steps { display: grid; gap: 10px; padding-left: 1.2em; list-style: disc; font-size: 18px; line-height: 1.6; }
  .steps strong { color: var(--heading); }
  .license { margin-top: 36px; color: var(--text-muted); font-size: 15px; }

  .author {
    display: grid;
    gap: 6px;
    margin-top: clamp(48px, 7vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }
  .author .name { color: var(--heading); font: 500 20px/1.3 var(--font-display); }
  .links { display: flex; gap: 20px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .links :global(svg) { width: 14px; height: 14px; }
</style>
