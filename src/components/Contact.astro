---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getCopy } from '../data/i18n';

const t = getCopy(Astro.currentLocale);
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel reveal">
      <div class="copy">
        <span class="label">{t.contact.label}</span>
        <h2 id="contact-title">{t.contact.title}<em>{t.contact.titleEm}</em></h2>
        <p>{t.contact.text}</p>
        <div class="actions">
          <a class="btn btn-light" href={site.contact}>{t.contact.cta} <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
      <div class="seal-art" aria-hidden="true">
        <Icon name="star" class="big-star" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Deep-green banner: vanilla text 9.7:1, Light Gold accents 4.9:1 */
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    overflow: hidden;
    padding: clamp(36px, 6vw, 72px);
    border-radius: var(--radius-xl);
    background: var(--green-deep);
    color: var(--vanilla);
  }
  :global([data-theme='dark']) .panel { box-shadow: inset 0 0 0 1px rgb(247 241 225 / 0.1); }
  .copy { position: relative; z-index: 1; display: grid; justify-items: start; gap: 20px; }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid rgb(201 169 106 / 0.5);
    border-radius: 999px;
    color: var(--gold-light);
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h2 {
    color: var(--vanilla);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2rem);
    line-height: 1.15;
    max-width: 22ch;
  }
  h2 em { color: var(--gold-light); }
  p { max-width: 36rem; color: var(--vanilla); opacity: 0.9; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .btn-light { background: var(--vanilla); color: var(--green-deep); }
  .btn-light:hover { background: var(--beige); }
  .btn-ghost { border-color: rgb(247 241 225 / 0.5); color: var(--vanilla); }
  .btn-ghost:hover { border-color: var(--vanilla); background: rgb(247 241 225 / 0.08); }
  .btn-light:focus-visible,
  .btn-ghost:focus-visible { outline-color: var(--gold-light); }

  .seal-art {
    position: absolute;
    right: -120px;
    top: 50%;
    width: 560px;
    height: 560px;
    transform: translateY(-50%);
    background: url('/guilloche.svg') center / contain no-repeat;
    opacity: 0.9;
    display: grid;
    place-items: center;
  }
  .seal-art :global(.big-star) { width: 40px; height: 40px; color: var(--gold-light); }

  @media (max-width: 900px) {
    .panel { grid-template-columns: 1fr; }
    .seal-art { right: -260px; opacity: 0.35; }
  }
  @media (max-width: 520px) {
    .actions { width: 100%; }
    .actions .btn { flex: 1 1 100%; }
    .btn-ghost { font-size: 14px; }
  }
</style>
