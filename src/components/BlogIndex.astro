---
// The blog home per language: /blog/ (es) and /nl/blog/ (nl).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { homePath } from '../data/i18n';
import { blog, blogPath } from '../data/blog';
import { readingPath } from '../data/reading';

interface Props {
  lang: 'es' | 'nl';
}

const { lang } = Astro.props;
const b = blog[lang];
const posts = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (x, y) => y.data.date.getTime() - x.data.date.getTime(),
);
const sections = (['ai', 'reading', 'archive'] as const)
  .map((id) => ({ id, ...b.sections[id], posts: posts.filter((p) => p.data.section === id) }))
  .filter((s) => s.posts.length);
const fmt = new Intl.DateTimeFormat(b.dateLocale, { month: 'short', year: 'numeric' });
const alternates = { es: blogPath.es, nl: blogPath.nl };
const url = new URL(blogPath[lang]!, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.brand },
    {
      '@type': 'Blog',
      '@id': url,
      url,
      name: `${b.title} · ${site.name}`,
      inLanguage: lang,
      author: { '@id': `${site.url}/#person` },
      isPartOf: { '@id': `${site.url}/#website` },
    },
  ],
};
---
<Base title={`${b.title} · ${site.name}`} description={b.description} lang={lang} alternates={alternates} jsonLd={jsonLd}>
  <Header lang={lang} alternates={alternates} />
  <main id="main" class="blog">
    <div class="container narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath(lang)}>{site.brand}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{b.title}</span>
      </nav>

      <header class="head">
        <h1>{b.title}</h1>
        <p class="lead">{b.intro}</p>
      </header>

      {sections.map((s) => (
        <section class="group" aria-labelledby={`s-${s.id}`}>
          <div class="group-head">
            <h2 id={`s-${s.id}`}>{s.title}</h2>
            <p>{s.text}</p>
            {s.id === 'reading' && (
              <a class="more" href={readingPath[lang]}>{b.readingLink} <Icon name="arrow-right" /></a>
            )}
          </div>
          <ul class="list">
            {s.posts.map((p) => (
              <li>
                <a href={p.data.permalink}>{p.data.title}</a>
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .blog { padding-block: clamp(40px, 6vw, 72px) clamp(72px, 10vw, 128px); }
  .narrow { max-width: 46rem; }

  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 44px);
    color: var(--text-muted);
    font: 400 13px/1.4 var(--font-mono);
  }
  .crumbs a { color: inherit; }

  .head { display: grid; gap: 20px; margin-bottom: clamp(40px, 6vw, 64px); }
  h1 { font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); line-height: 1.05; }

  .group + .group { margin-top: clamp(40px, 6vw, 64px); }
  .group-head { display: grid; gap: 8px; justify-items: start; margin-bottom: 16px; }
  .group-head h2 { font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.75rem); }
  .group-head p { color: var(--text-muted); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .more :global(svg) { width: 14px; height: 14px; }

  .list { border-top: 1px solid var(--border); }
  .list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .list a { color: var(--heading); font: 500 19px/1.35 var(--font-display); text-decoration: none; }
  .list a:hover { color: var(--emphasis); text-decoration: underline; }
  .list time { flex: none; color: var(--text-muted); font: 400 13px/1.4 var(--font-mono); }
</style>
