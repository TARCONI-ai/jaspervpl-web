---
// One blog post. Rendered by src/pages/blog/[...permalink].astro (es) and src/pages/nl/blog/[...permalink].astro (nl).
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { homePath } from '../data/i18n';
import { blog, blogPath, excerpt } from '../data/blog';
import { reading, readingPath } from '../data/reading';

interface Props {
  post: CollectionEntry<'blog'>;
  alt?: CollectionEntry<'blog'>;
}

const { post, alt } = Astro.props;
const d = post.data;
const lang = d.lang;
const b = blog[lang];
const r = reading[lang];
const { Content } = await render(post);

const url = new URL(d.permalink, Astro.site).href;
const description = d.description ?? excerpt(post.body);
const cover = d.cover ? await getImage({ src: d.cover, width: 1200, format: 'jpeg' }) : undefined;
const iso = (date: Date) => date.toISOString().slice(0, 10);
const fmt = new Intl.DateTimeFormat(b.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
const alternates = { [lang]: d.permalink, ...(alt ? { [alt.data.lang]: alt.data.permalink } : {}) };

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.brand },
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: d.title,
      inLanguage: lang,
      isPartOf: { '@id': `${site.url}/#website` },
      breadcrumb: { '@id': `${url}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.brand, item: new URL(homePath(lang), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: b.title, item: new URL(blogPath[lang]!, Astro.site).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: url },
      ],
    },
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description,
      inLanguage: lang,
      mainEntityOfPage: { '@id': url },
      datePublished: iso(d.date),
      dateModified: iso(d.updated ?? d.date),
      author: { '@id': `${site.url}/#person` },
      ...(cover ? { image: new URL(cover.src, Astro.site).href } : {}),
    },
  ],
};
---
<Base title={`${d.title} · ${site.name}`} description={description} lang={lang} alternates={alternates} jsonLd={jsonLd} ogImage={cover?.src}>
  <Header lang={lang} alternates={alternates} />
  <main id="main" class="post">
    <article class="container narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath(lang)}>{site.brand}</a>
        <span aria-hidden="true">/</span>
        <a href={blogPath[lang]}>{b.title}</a>
      </nav>

      <header class="head">
        <h1>{d.title}</h1>
        <p class="byline">
          {r.labels.author} <a href={homePath(lang)}>{site.name}</a>{' · '}
          {b.published} <time datetime={iso(d.date)}>{fmt.format(d.date)}</time>
          {d.updated && <>{' · '}{b.updated} <time datetime={iso(d.updated)}>{fmt.format(d.updated)}</time></>}
        </p>
      </header>

      {d.section === 'archive' && <p class="note">{b.archiveNote(d.date.getFullYear())}</p>}
      {d.section === 'reading' && (
        <p class="note">
          {b.readingNote} <a href={readingPath[lang]}>{b.readingLink} <Icon name="arrow-right" /></a>
        </p>
      )}

      <div class="prose">
        <Content />
      </div>

      <aside class="author" aria-label={r.labels.author}>
        <p class="name">{site.name}</p>
        <p>{r.authorBio}</p>
        <p class="links">
          <a href={site.linkedin} rel="me noopener">LinkedIn <Icon name="arrow-up-right" /></a>
          <a href={site.github} rel="me noopener">GitHub <Icon name="arrow-up-right" /></a>
        </p>
      </aside>
    </article>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .post { padding-block: clamp(40px, 6vw, 72px) clamp(72px, 10vw, 128px); }
  .narrow { max-width: 46rem; }

  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 44px);
    color: var(--text-muted);
    font: 400 13px/1.4 var(--font-mono);
  }
  .crumbs a { color: inherit; }

  .head { display: grid; gap: 18px; margin-bottom: 32px; }
  h1 { font-size: clamp(2rem, 1.6rem + 2vw, 3rem); line-height: 1.1; }
  .byline { color: var(--text-muted); font-size: 14px; }

  .note {
    margin-bottom: 32px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--decor);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 15px;
  }
  .note a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .note :global(svg) { width: 14px; height: 14px; }

  .prose { font-size: 18px; line-height: 1.7; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { margin-top: 2em; font-size: 1.6rem; line-height: 1.2; }
  .prose :global(h3) { margin-top: 1.6em; font-size: 1.3rem; line-height: 1.25; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }
  .prose :global(blockquote) { padding-left: 1em; border-left: 3px solid var(--decor); color: var(--text-muted); }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 15px; }
  .prose :global(th), .prose :global(td) { padding: 8px 12px; border: 1px solid var(--border); text-align: left; }
  .prose :global(code) { font: 400 0.9em var(--font-mono); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); }

  .author {
    display: grid;
    gap: 6px;
    margin-top: clamp(48px, 7vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }
  .author .name { color: var(--heading); font: 500 20px/1.3 var(--font-display); }
  .links { display: flex; gap: 20px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .links :global(svg) { width: 14px; height: 14px; }
</style>
