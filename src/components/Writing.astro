---
import Icon from './Icon.astro';
import { articles, site } from '../data/site';
import { getCopy } from '../data/i18n';

const t = getCopy(Astro.currentLocale);
const fmt = new Intl.DateTimeFormat(t.writing.dateLocale, { day: 'numeric', month: 'short', year: 'numeric' });
---
<section class="section writing" id="writing" aria-labelledby="writing-title">
  <div class="container">
    <div class="head-row">
      <header class="section-head reveal">
        <span class="eyebrow">{t.writing.eyebrow}</span>
        <h2 id="writing-title">{t.writing.title}<em>{t.writing.titleEm}</em></h2>
        <p>{t.writing.intro}</p>
      </header>
      <a class="btn btn-secondary reveal" href={site.blog}>{t.writing.all} <Icon name="arrow-right" /></a>
    </div>

    <ul class="list">
      {articles.map((a, i) => (
        <li class="reveal" style={`--delay:${i * 0.08}s`}>
          <a class="card post" href={a.href}>
            <span class="post-meta">
              <span>{t.writing.topics[a.topic]}</span>
              <time datetime={a.date}>{fmt.format(new Date(a.date))}</time>
            </span>
            <h3 lang="es">{a.title}</h3>
            <span class="post-more">{t.writing.readMore} <Icon name="arrow-up-right" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .head-row .section-head { margin-bottom: 0; }
  .list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .list li { display: flex; }
  .post {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
    width: 100%;
    padding: 26px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .post:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: color-mix(in srgb, var(--emphasis) 35%, var(--border));
  }
  .post-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font: 400 12px/1.4 var(--font-mono);
  }
  h3 { font-size: 24px; line-height: 1.25; }
  .post-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--emphasis);
    font-weight: 600;
    font-size: 15px;
  }
  .post:hover .post-more { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 1080px) { .list { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .head-row { flex-direction: column; align-items: flex-start; }
  }
</style>
