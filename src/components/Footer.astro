---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { getCopy, getLang, homePath, type Lang } from '../data/i18n';
import { readingPath } from '../data/reading';

interface Props {
  // Page language when the URL does not carry it
  lang?: Lang;
}
const lang = Astro.props.lang ?? getLang(Astro.currentLocale);
const t = getCopy(lang);
const home = homePath(lang);
const base = Astro.url.pathname === home ? '' : home;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="sig">
        <a href={home} aria-label={t.a11y.home}><Logo variant="lockup" class="footer-logo" /></a>
        <p>{t.tagline}</p>
      </div>
      <nav class="cols" aria-label={t.a11y.footerNav}>
        <div>
          <h2 class="col-title">{t.footer.site}</h2>
          <ul>
            {nav.map((id) => <li><a href={`${base}#${id}`}>{t.nav[id]}</a></li>)}
            <li><a href={readingPath[lang]}>{t.nav.reading}</a></li>
            <li><a href={`${base}#contact`}>{t.nav.contact}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="col-title">{t.footer.elsewhere}</h2>
          <ul>
            <li><a href={site.linkedin} rel="me noopener">LinkedIn <Icon name="arrow-up-right" /></a></li>
            <li><a href={site.blog}>Blog <Icon name="arrow-up-right" /></a></li>
            <li><a href={`mailto:${site.email}`}>{t.footer.email}</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <p class="signature" aria-hidden="true">jaspervpl<span>.com</span></p>

    <div class="bottom">
      <p>© {year} {site.name} · <a href={site.url}>{site.domain}</a></p>
      <p>{t.footer.colophon}</p>
    </div>
  </div>
</footer>

<style>
  /* Light-vanilla surface so Text Gold labels clear 4.5:1 (4.67:1) */
  .site-footer {
    padding-top: clamp(56px, 8vw, 96px);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .sig { display: grid; align-content: start; gap: 16px; max-width: 22rem; }
  .sig a { justify-self: start; border-radius: 8px; }
  .sig :global(.footer-logo) { width: 190px; }
  .sig p { color: var(--text-muted); }
  .cols { display: flex; gap: clamp(40px, 8vw, 96px); }
  .col-title {
    margin-bottom: 14px;
    color: var(--label);
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cols ul { display: grid; gap: 8px; }
  .cols a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
    text-decoration: none;
  }
  .cols a:hover { color: var(--emphasis); text-decoration: underline; }

  .signature {
    margin: clamp(40px, 7vw, 80px) 0 0;
    color: var(--heading);
    font: italic 500 clamp(3.5rem, 1rem + 11vw, 10rem)/0.9 var(--font-display);
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
  }
  .signature span { color: var(--emphasis); }

  .bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: clamp(24px, 4vw, 40px);
    padding-block: 22px 28px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 14px;
  }
  .bottom a { color: inherit; }
</style>
