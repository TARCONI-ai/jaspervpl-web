---
// The one-page site, rendered once per language by src/pages/{,es/,nl/}index.astro.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Stack from './Stack.astro';
import Method from './Method.astro';
import Work from './Work.astro';
import About from './About.astro';
import Writing from './Writing.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { getCopy } from '../data/i18n';

const t = getCopy(Astro.currentLocale);
---
<Base title={t.meta.title} description={t.meta.description}>
  <Header />
  <main id="main">
    <Hero />
    <Work />
    <Method />
    <Stack />
    <About />
    <Writing />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  // Fade sections in once, as they enter the viewport
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      });
    },
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
