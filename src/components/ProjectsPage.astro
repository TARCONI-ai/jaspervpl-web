---
// Projects index (no slug) or one project (slug). Rendered by src/pages/{projects,es/proyectos,nl/projecten}/.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { site, pageTitle, fitText } from '../data/site';
import { getLang, homePath, type Lang } from '../data/i18n';
import { categoryIds, projectLabels, projects, projectsPath } from '../data/projects';
import { reading } from '../data/reading';

interface Props {
  slug?: string;
}

const lang = getLang(Astro.currentLocale);
const l = projectLabels[lang];
const p = Astro.props.slug ? projects.find((x) => x.slug === Astro.props.slug) : undefined;
const c = p?.copy[lang];
const pathOf = (x: Lang) => (p ? `${projectsPath[x]}${p.slug}/` : projectsPath[x]);
const alternates = { en: pathOf('en'), es: pathOf('es'), nl: pathOf('nl') };
const url = new URL(pathOf(lang), Astro.site).href;
const fmt = new Intl.DateTimeFormat(l.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });

const groups = categoryIds.map((id) => ({ id, title: l.categories[id], items: projects.filter((x) => x.category === id) }));

const crumbs = [
  { name: site.brand, item: new URL(homePath(lang), Astro.site).href },
  { name: l.title, item: new URL(projectsPath[lang], Astro.site).href },
  ...(p ? [{ name: p.name, item: url }] : []),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.brand },
    {
      '@type': p ? 'WebPage' : 'CollectionPage',
      '@id': url,
      url,
      name: p ? p.name : l.title,
      description: c ? c.tagline : l.description,
      inLanguage: lang,
      isPartOf: { '@id': `${site.url}/#website` },
      breadcrumb: { '@id': `${url}#breadcrumb` },
      ...(p ? { dateModified: p.modified, author: { '@id': `${site.url}/#person` } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: crumbs.map((x, i) => ({ '@type': 'ListItem', position: i + 1, ...x })),
    },
  ],
};
---
<Base
  title={p ? pageTitle(`${p.name}: ${c!.tagline.replace(/\.$/, '')}`) : pageTitle(l.title)}
  description={c ? fitText(c.summary) : l.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Header alternates={alternates} />
  <main id="main" class="projects">
    <div class:list={['container', { narrow: p }]}>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath(lang)}>{site.brand}</a>
        <span aria-hidden="true">/</span>
        {p ? <a href={projectsPath[lang]}>{l.title}</a> : <span aria-current="page">{l.title}</span>}
      </nav>

      {!p && (
        <>
          <header class="head">
            <h1>{l.title}</h1>
            <p class="lead">{l.intro}</p>
          </header>
          {groups.map((g) => (
            <section class="group" aria-labelledby={`cat-${g.id}`}>
              <h2 id={`cat-${g.id}`} class="eyebrow">{g.title}</h2>
              <ul class="cards">
                {g.items.map((x) => (
                  <li>
                    <a class="card item" href={`${projectsPath[lang]}${x.slug}/`}>
                      <h3>{x.name}</h3>
                      <p>{x.copy[lang].tagline}</p>
                      <ul class="tags">{x.stack.slice(0, 3).map((t) => <li>{t}</li>)}</ul>
                      <span class="more">{l.open} <Icon name="arrow-right" /></span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </>
      )}

      {p && c && (
        <article>
          <header class="head">
            <span class="tag">{l.categories[p.category]}</span>
            <h1>{p.name}</h1>
            <p class="lead">{c.tagline}</p>
            <p class="byline">
              {l.author} <a href={homePath(lang)}>{site.name}</a>{' · '}
              {l.updated} <time datetime={p.modified}>{fmt.format(new Date(p.modified))}</time>
            </p>
            {(p.github || p.appStore || p.resource) && (
              <div class="actions">
                {p.resource && <a class="btn btn-primary" href={p.resource[lang]}>{l.resource} <Icon name="arrow-right" /></a>}
                {p.appStore && <a class="btn btn-primary" href={p.appStore} rel="noopener">{l.appStore} <Icon name="arrow-up-right" /></a>}
                {p.github && (
                  <a class="btn btn-secondary" href={p.github.url} rel="noopener">
                    {p.github.label === 'case' ? l.githubCase : l.github} <Icon name="arrow-up-right" />
                  </a>
                )}
              </div>
            )}
          </header>

          <section class="block"><h2>{l.problem}</h2><p>{c.problem}</p></section>
          <section class="block"><h2>{l.constraint}</h2><p>{c.constraint}</p></section>
          <section class="block">
            <h2>{l.decisions}</h2>
            <ul class="steps">{c.decisions.map((d) => <li>{d}</li>)}</ul>
          </section>
          <section class="block"><h2>{l.result}</h2><p>{c.result}</p></section>
          <section class="block">
            <h2>{l.stack}</h2>
            <ul class="tags">{p.stack.map((t) => <li>{t}</li>)}</ul>
          </section>

          <aside class="author" aria-label={l.author}>
            <p class="name">{site.name}</p>
            <p>{reading[lang].authorBio}</p>
            <p class="links">
              <a href={site.linkedin} rel="me noopener">LinkedIn <Icon name="arrow-up-right" /></a>
              <a href={site.github} rel="me noopener">GitHub <Icon name="arrow-up-right" /></a>
            </p>
          </aside>
        </article>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .projects { padding-block: clamp(40px, 6vw, 72px) clamp(72px, 10vw, 128px); }
  .narrow { max-width: 46rem; }

  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 44px);
    color: var(--text-muted);
    font: 400 13px/1.4 var(--font-mono);
  }
  .crumbs a { color: inherit; }

  .head { display: grid; gap: 18px; justify-items: start; margin-bottom: clamp(36px, 5vw, 56px); }
  h1 { font-size: clamp(2rem, 1.6rem + 2vw, 3rem); line-height: 1.1; }
  .byline { color: var(--text-muted); font-size: 14px; }
  .tag { color: var(--text-muted); font: 400 13px/1.4 var(--font-mono); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .group + .group { margin-top: clamp(40px, 6vw, 64px); }
  .group h2 { margin-bottom: 20px; }
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .cards > li { display: flex; }
  .item { display: grid; grid-template-rows: auto 1fr auto auto; gap: 12px; width: 100%; padding: clamp(22px, 3vw, 32px); color: inherit; text-decoration: none; transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .item:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft); }
  .item h3 { font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem); line-height: 1.2; }
  .item p { color: var(--text-muted); }
  .more { display: inline-flex; align-items: center; gap: 8px; color: var(--emphasis); font-weight: 600; }
  .more :global(svg) { width: 16px; height: 16px; }

  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font: 400 12px/1.4 var(--font-mono);
  }

  .block + .block { margin-top: 36px; }
  .block h2 { margin-bottom: 12px; font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.6rem); }
  .block p { font-size: 18px; line-height: 1.7; }
  .steps { display: grid; gap: 10px; padding-left: 1.2em; list-style: disc; font-size: 18px; line-height: 1.6; }

  .author {
    display: grid;
    gap: 6px;
    margin-top: clamp(48px, 7vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }
  .author .name { color: var(--heading); font: 500 20px/1.3 var(--font-display); }
  .links { display: flex; gap: 20px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .links :global(svg) { width: 14px; height: 14px; }

  @media (max-width: 760px) { .cards { grid-template-columns: 1fr; } }
</style>
